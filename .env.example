# ── Render worker environment ────────────────────────────────────────────
# Copy to .env for local runs and to GitHub Actions Secrets (or Wrangler /
# Docker -e flags). NEVER commit real values — this file is names only.

# Cloudflare backend (the Worker serves the API + job queue).
CHANNELRY_CLOUD_API_URL=https://api.channelryapp.sbs
# Server-to-server token the worker uses for claim/progress/complete.
# This is the existing WORKER_TOKEN bound to the channelry-admin Worker.
# Equivalent to the plan's RENDERER_TOKEN. Keep out of git.
CHANNELRY_RENDER_WORKER_TOKEN=
# On GitHub Actions these are auto-generated per run
#   (renderer-a-${{ github.run_id }}) and do NOT need to be set as secrets.
CHANNELRY_RENDER_WORKER_ID=renderer-a
CHANNELRY_RENDER_WORKER_NAME=renderer-a

# R2 (S3-compatible, bucket "channelry-videos").
CHANNELRY_R2_ENDPOINT=
CHANNELRY_R2_BUCKET=channelry-videos
CHANNELRY_R2_ACCESS_KEY_ID=
CHANNELRY_R2_SECRET_ACCESS_KEY=
CHANNELRY_R2_PUBLIC_BASE_URL=

# Optional tuning.
CHANNELRY_RENDER_POLL_SECONDS=3
CHANNELRY_RENDER_MAX_SECONDS=600
CHANNELRY_OUTPUT_WIDTH=1280
CHANNELRY_OUTPUT_HEIGHT=720
# Set to 1 to skip rembg (passthrough) — handy for a quick local smoke test.
CHANNELRY_FORCE_NO_REMBG=0
# Temp workspace root on the runner (ephemeral — safe to keep local).
CHANNELRY_WORKSPACE=/tmp